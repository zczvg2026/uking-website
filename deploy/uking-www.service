[Unit]
Description=UKing Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uking
Group=uking
WorkingDirectory=/srv/uking/current
Environment=NODE_ENV=production
Environment=PATH=/opt/node-v24.18.0-linux-x64/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node-v24.18.0-linux-x64/bin/npm start -- --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
